# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as GOOGLE_MAPS_API_KEY below; restrict to your domain in Google Cloud Console.
# When unset the ResultsMap falls back to the lightweight iframe.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend secrets
NVIDIA_API_KEY=your_real_key_here
GOOGLE_MAPS_API_KEY=your_real_key_here
USDA_API_KEY=your_real_key_here
SUPABASE_URL=your_real_key_here
SUPABASE_ANON_KEY=your_real_key_here
SUPABASE_SERVICE_ROLE_KEY=your_real_key_here

NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional default demo location
DEFAULT_LAT=44.5646
DEFAULT_LNG=-123.2620
DEFAULT_CITY=Corvallis
DEFAULT_COUNTRY=United States
