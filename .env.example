# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (frontend - safe to ship)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Backend (api/.env)
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed for CORS. Leave unset for localhost-only.
CORS_ORIGINS=http://localhost:3000

# NVIDIA / Nemotron - both required, no defaults
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Optional override - defaults to https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# Google & USDA
GOOGLE_MAPS_API_KEY=
USDA_API_KEY=

# Supabase (backend - service role key, never expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CLI test scripts only - the API endpoint takes lat/lng from the request
CURRENT_LAT=
CURRENT_LNG=
